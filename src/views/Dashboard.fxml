<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" prefHeight="700.0" prefWidth="900.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">
   
   <!-- SOL MENÜ (SIDEBAR) -->
   <left>
      <VBox prefWidth="240.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="label-header" text="FIT TRACKER">
               <VBox.margin>
                  <Insets bottom="40.0" left="25.0" top="30.0" />
               </VBox.margin>
            </Label>
            
            <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#handleMenuClick" prefHeight="55.0" prefWidth="240.0" styleClass="button-sidebar" text="Dashboard" />
            <Button fx:id="btnNewWorkout" mnemonicParsing="false" onAction="#handleMenuClick" prefHeight="55.0" prefWidth="240.0" styleClass="button-sidebar" text="New Workout" />
            <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#handleMenuClick" prefHeight="55.0" prefWidth="240.0" styleClass="button-sidebar" text="History" />
            
            <!-- YENİ EKLENEN HAREKETLER (KÜTÜPHANE) BUTONU -->
            <Button fx:id="btnExercises" mnemonicParsing="false" onAction="#handleMenuClick" prefHeight="55.0" prefWidth="240.0" styleClass="button-sidebar" text="Exercises" />
            
            <Button fx:id="btnSupplements" mnemonicParsing="false" onAction="#handleMenuClick" prefHeight="55.0" prefWidth="240.0" styleClass="button-sidebar" text="Supplements" />
            <Button fx:id="btnSettings" mnemonicParsing="false" onAction="#handleMenuClick" prefHeight="55.0" prefWidth="240.0" styleClass="button-sidebar" text="Settings" />
         </children>
      </VBox>
   </left>
   
   <!-- İÇERİK ALANI (Diğer sayfalar buraya yüklenecek) -->
   <center>
   </center>
   
</BorderPane>