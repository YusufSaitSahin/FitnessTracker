<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="700.0" prefWidth="600.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SupplementController">
   <children>
      <VBox alignment="CENTER" maxWidth="450.0" spacing="25.0" styleClass="card">
         <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
         </padding>
         <children>
            <!-- Label kısmını uygulamanın geneli İngilizce olduğu için uyumlu hale getirdim -->
            <Label styleClass="label-header" text="Daily Supplements" />
            
            <DatePicker fx:id="datePicker" prefHeight="45.0" prefWidth="250.0" promptText="Select Date" styleClass="date-picker" />
            
            <VBox alignment="CENTER_LEFT" maxWidth="200.0" spacing="20.0">
               <children>
                  <CheckBox fx:id="chkWhey" mnemonicParsing="false" styleClass="check-box" text="Whey Protein" />
                  <CheckBox fx:id="chkCreatine" mnemonicParsing="false" styleClass="check-box" text="Creatine" />
                  <CheckBox fx:id="chkVitD" mnemonicParsing="false" styleClass="check-box" text="Vitamin D" />
                  <CheckBox fx:id="chkFishOil" mnemonicParsing="false" styleClass="check-box" text="Fish Oil" />
               </children>
            </VBox>
            
            <Button fx:id="btnSaveSupplement" mnemonicParsing="false" onAction="#handleSave" prefHeight="45.0" prefWidth="250.0" styleClass="button-primary" text="Save">
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</VBox>