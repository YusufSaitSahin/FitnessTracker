<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="600.0" spacing="20.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.WorkoutDetailsController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
  
     
      <StackPane styleClass="card">
         <children>
       
            <VBox spacing="15.0">
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </padding>
               <children>
              
                  <Label fx:id="lblWorkoutTitle" styleClass="label-header" text="Workout Details" />
                  
                 
                  <TextField fx:id="txtSearchExercise" prefHeight="45.0" promptText="Hareket ara (örn: Bench Press)..." />

                  <Label fx:id="lblLastRecord" styleClass="label-secondary" text="Last Record: -" />
            
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <children>
                        <TextField fx:id="txtWeight" prefHeight="45.0" prefWidth="110.0" promptText="Ağırlık (kg)" />
                        <TextField fx:id="txtReps" prefHeight="45.0" prefWidth="110.0" promptText="Tekrar" />
                        <Button fx:id="btnAddSet" mnemonicParsing="false" onAction="#handleAddSet" prefHeight="45.0" prefWidth="130.0" styleClass="button-primary" text="+ Set Ekle" />
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>

         
            <ListView fx:id="listExerciseSuggestions" maxHeight="150.0" style="-fx-background-color: #2C2C2E; -fx-control-inner-background: #2C2C2E; -fx-border-color: #007AFF; -fx-border-radius: 5; -fx-background-radius: 5;" visible="false" StackPane.alignment="TOP_CENTER">
               <StackPane.margin>
         
                  <Insets left="25.0" right="25.0" top="105.0" />
               </StackPane.margin>
            </ListView>
         </children>
      </StackPane>
      
     
      <VBox styleClass="card" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <TableView fx:id="tableSets" prefHeight="350.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colExercise" prefWidth="220.0" text="Hareket" />
                <TableColumn fx:id="colSetNum" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Set" />
                <TableColumn fx:id="colWeight" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Ağırlık (kg)" />
                <TableColumn fx:id="colReps" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Tekrar" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      
     
      <VBox alignment="CENTER" spacing="12.0">
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
         <children>
            <Button fx:id="btnReadyRoutine" mnemonicParsing="false" onAction="#openActiveRoutine" prefHeight="45.0" prefWidth="280.0" styleClass="button-primary" text="📋 Hazır Rutin Yükle" />
            <Button fx:id="btnFinish" mnemonicParsing="false" onAction="#handleFinish" prefHeight="55.0" prefWidth="280.0" styleClass="button-success" text="✓ Antrenmanı Bitir" />
         </children>
      </VBox>

   </children>
</VBox>