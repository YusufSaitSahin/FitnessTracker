<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="600.0" spacing="20.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HistoryController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <Label styleClass="label-header" text="Workout History" />
      
      <!-- Arama Kartı -->
      <HBox alignment="CENTER" spacing="15.0" styleClass="card">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <DatePicker fx:id="datePicker" prefHeight="45.0" prefWidth="220.0" promptText="Select a Date" styleClass="date-picker" />
            <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch" prefHeight="45.0" prefWidth="120.0" styleClass="button-primary" text="Search" />
         </children>
      </HBox>
      
      <!-- Tablo Kartı -->
      <VBox styleClass="card" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <TableView fx:id="tableHistory" prefHeight="400.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colExercise" prefWidth="220.0" text="Exercise" />
                <TableColumn fx:id="colSetNum" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Set" />
                <TableColumn fx:id="colReps" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Reps" />
                <TableColumn fx:id="colWeight" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Weight (kg)" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>