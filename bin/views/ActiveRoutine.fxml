<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #1C1C1E;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ActiveRoutineController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      
   
      <Label styleClass="label-header" text="Aktif Antrenman" />
      <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px;" text="Aşağıdaki hazır rutin için yaptığın tekrar ve ağırlıkları gir." />
      
     
      <TableView fx:id="tableRoutine" prefHeight="400.0" style="-fx-background-color: transparent; -fx-control-inner-background: #1C1C1E; -fx-table-cell-border-color: #2C2C2E;" VBox.vgrow="ALWAYS">
        <columns>
        
          <TableColumn fx:id="colExercise" prefWidth="220.0" text="Hareket Adı" />
          <TableColumn fx:id="colSet" prefWidth="80.0" text="Set" />
          
      
          <TableColumn fx:id="colReps" prefWidth="120.0" text="Tekrar" />
          <TableColumn fx:id="colWeight" prefWidth="120.0" text="Ağırlık (KG)" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
  
      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <children>
            <Button fx:id="btnFinishWorkout" mnemonicParsing="false" onAction="#finishWorkout" style="-fx-background-color: #30D158; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12 40; -fx-background-radius: 8;" text="✓ Antrenmanı Bitir" />
         </children>
      </HBox>
      
   </children>
</VBox>